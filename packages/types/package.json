{
  "name": "@swift/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared типы и Zod-схемы между frontend и backend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swift/config": "workspace:*",
    "eslint": "^9.9.0",
    "typescript": "^5.5.0"
  }
}
